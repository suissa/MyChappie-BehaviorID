{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mychappie.dev/schemas/behaviorid/situational-behavior-pattern-v1.json",
  "title": "SituationalBehaviorPattern v1",
  "type": "object",
  "required": ["id", "subjectId", "conditioningBehavior", "situation", "prediction", "exceptions", "supportingEvidence", "contradictingEvidence", "confidence", "schemaVersion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "conditioningBehavior": {
      "type": "object",
      "required": ["current"],
      "properties": { "previous": { "type": "string" }, "transition": { "type": "string" }, "current": { "type": "string", "minLength": 1 } }
    },
    "situation": { "type": "object" },
    "prediction": { "type": "object", "required": ["nextState"], "properties": { "nextState": { "type": "string", "minLength": 1 }, "transitionLabel": { "type": "string" } } },
    "exceptions": { "type": "array" },
    "supportingEvidence": { "$ref": "#/$defs/evidence" },
    "contradictingEvidence": { "$ref": "#/$defs/evidence" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "schemaVersion": { "const": 1 }
  },
  "anyOf": [{ "properties": { "supportingEvidence": { "minItems": 1 } } }, { "properties": { "contradictingEvidence": { "minItems": 1 } } }],
  "$defs": {
    "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "observedAt", "behaviorIdRef", "situation"] } }
  }
}
